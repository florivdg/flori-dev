---
interface Props {
  title: string
  caption?: string
}

const { title, caption } = Astro.props
---

<figure class="viz not-prose my-10 rounded-lg border px-4 py-5 sm:px-6">
  <figcaption class="viz-ink mb-4 text-base font-semibold text-balance">
    {title}
  </figcaption>
  <slot />
  {caption && <p class="viz-muted mt-5 text-xs leading-relaxed">{caption}</p>}
</figure>

<style>
  .viz {
    --viz-surface: #ffffff;
    --viz-border: #e4e4e7;
    --viz-grid: #e5e7eb;
    --viz-band: #f1f5f9;
    --viz-ink: #0f172a;
    --viz-ink-2: #475569;
    --viz-muted: #64748b;
    --viz-s1: #2a78d6;
    --viz-s2: #eb6834;
    --viz-s3: #1baf7a;
    --viz-s4: #eda100;
    background: var(--viz-surface);
    border-color: var(--viz-border);
    color: var(--viz-ink-2);
  }

  @media (prefers-color-scheme: dark) {
    .viz {
      --viz-surface: #1f2937;
      --viz-border: #374151;
      --viz-grid: #374151;
      --viz-band: #273244;
      --viz-ink: #f1f5f9;
      --viz-ink-2: #cbd5e1;
      --viz-muted: #94a3b8;
      --viz-s1: #3987e5;
      --viz-s2: #d95926;
      --viz-s3: #199e70;
      --viz-s4: #c98500;
    }
  }

  :global(.dark) .viz {
    --viz-surface: #1f2937;
    --viz-border: #374151;
    --viz-grid: #374151;
    --viz-band: #273244;
    --viz-ink: #f1f5f9;
    --viz-ink-2: #cbd5e1;
    --viz-muted: #94a3b8;
    --viz-s1: #3987e5;
    --viz-s2: #d95926;
    --viz-s3: #199e70;
    --viz-s4: #c98500;
  }

  .viz :global(.viz-ink) {
    color: var(--viz-ink);
  }

  .viz :global(.viz-muted) {
    color: var(--viz-muted);
  }

  /*
   * Entry animation. The script below marks each figure as `pending` and
   * flips it to `in` once it scrolls into view. Without JavaScript or with
   * reduced motion, no figure is ever marked, so everything renders static.
   */
  @media (prefers-reduced-motion: no-preference) {
    .viz[data-animate] :global(:is(.viz-grow-x, .viz-grow-y)) {
      transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
    }
    .viz[data-animate] :global(.viz-grow-x) {
      transform-origin: left center;
    }
    .viz[data-animate] :global(.viz-grow-y) {
      transform-origin: center bottom;
    }
    .viz[data-animate='pending'] :global(.viz-grow-x) {
      transform: scaleX(0);
    }
    .viz[data-animate='pending'] :global(.viz-grow-y) {
      transform: scaleY(0);
    }

    .viz[data-animate] :global(.viz-pop) {
      transition:
        transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0ms),
        opacity 200ms ease-out var(--d, 0ms);
    }
    .viz[data-animate='pending'] :global(.viz-pop) {
      transform: scale(0.3);
      opacity: 0;
    }

    .viz[data-animate] :global(:is(.viz-fade, .viz-fade-up)) {
      transition:
        transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms),
        opacity 500ms ease-out var(--d, 0ms);
    }
    .viz[data-animate='pending'] :global(:is(.viz-fade, .viz-fade-up)) {
      opacity: 0;
    }
    .viz[data-animate='pending'] :global(.viz-fade-up) {
      transform: translateY(8px);
    }

    .viz[data-animate] :global(.viz-reveal) {
      transition: clip-path 1200ms linear var(--d, 0ms);
      clip-path: inset(-10px -10px -10px -10px);
    }
    .viz[data-animate='pending'] :global(.viz-reveal) {
      clip-path: inset(-10px 100% -10px -10px);
    }
  }
</style>

<script>
  const figures = document.querySelectorAll<HTMLElement>('figure.viz')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!reduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const figure = entry.target as HTMLElement
          observer.unobserve(figure)
          // Let the pending state paint once so the transition has a start.
          requestAnimationFrame(() =>
            requestAnimationFrame(() => (figure.dataset.animate = 'in')),
          )
        }
      },
      { threshold: 0.35 },
    )

    for (const figure of figures) {
      figure.dataset.animate = 'pending'
      observer.observe(figure)
    }
  }
</script>
